{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build:functions": "npm --prefix functions run build",
    "test:functions": "npm --prefix functions test",
    "deploy:functions": "npm --prefix functions run build && firebase deploy --only functions,firestore:rules --project gen-lang-client-0687330979",
    "firebase": "firebase",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:mobile": "playwright test e2e/mobile-android-inspector.spec.ts --project=\"Mobile Pixel 5\"",
    "test:mobile:matrix": "playwright test e2e/mobile-android-inspector.spec.ts --project=\"Mobile Pixel 5\" --project=\"Mobile Galaxy S20 (360x800)\" --project=\"Mobile Compact (320x640)\"",
    "test:pwa": "playwright test e2e/pwa-mobile-usage.spec.ts --project=\"Mobile Pixel 5\"",
    "test:pwa:matrix": "playwright test e2e/pwa-mobile-usage.spec.ts --project=\"Mobile Pixel 5\" --project=\"Mobile Galaxy S20 (360x800)\"",
    "create-pr": "node scripts/create_pr.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.15",
    "@rollup/rollup-win32-x64-msvc": "^4.65.0"
  }
}
